# AlexDesk AI - Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://username:password@localhost:5432/alexdesk_hvac
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alexdesk_hvac
# Optional granular parameters if DATABASE_URL is not set:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=alexdesk_hvac

# AI Provider Configuration
# Set your OpenAI API key to use live GPT-4o / GPT-4o-mini models.
# If not set, AlexDesk AI automatically uses its built-in HVAC conversational engine
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# HVAC Business Details
COMPANY_NAME=Apex Comfort Heating & Air
COMPANY_PHONE=(555) 349-2665
EMERGENCY_GAS_UTILITY_PHONE=911 or Atmos Energy (866) 322-8667
SERVICE_AREA=Greater Metro & Surrounding Counties
DISPATCH_EMAIL=dispatch@apexcomforthvac.com

# Twilio Telephony Webhook Secret / Auth (Future Voice & SMS Integration)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
